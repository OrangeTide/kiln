builddir build/$Triplet
set cflags "-Wall -O2"

# Shared library object
rule greet.o {
    inputs greet.c
    depfile greet.d
    command {cc $cflags -c -o $out $in -MMD -MF $depfile}
}

# hello program
rule hello.o {
    inputs hello.c
    depfile hello.d
    command {cc $cflags -c -o $out $in -MMD -MF $depfile}
}

rule hello {
    inputs hello.o greet.o
    command {cc -o $out $in}
}

# goodbye program
rule goodbye.o {
    inputs goodbye.c
    depfile goodbye.d
    command {cc $cflags -c -o $out $in -MMD -MF $depfile}
}

rule goodbye {
    inputs goodbye.o greet.o
    command {cc -o $out $in}
}

# Build both programs by default; the run targets below stay on demand.
default hello goodbye

# Run the built programs on demand:  kiln run-hello  /  kiln run-goodbye
# The program is built first, then launched (through $RUN if set).
run run-hello hello {}
run run-goodbye goodbye {}
