# Cross-compilation example: C + x86-64 assembly for Windows.
#
# Mixes a C source file with a NASM assembly file, cross-compiled
# to a Windows PE executable using mingw-w64 and NASM.
#
# Usage:
#   kiln --triplet x86_64-w64-mingw32
#
# Requires:
#   NASM:     nasm.us (assembler for x86/x86-64)
#   mingw-w64 toolchain:
#     Debian/Ubuntu: apt install gcc-mingw-w64-x86-64 nasm
#     Fedora:        dnf install mingw64-gcc nasm
#     Arch:          pacman -S mingw-w64-gcc nasm
#     macOS:         brew install mingw-w64 nasm

builddir build/$Triplet
set cc "$Triplet-gcc"
set cflags "-Wall -O2"

# Assemble the .asm file with NASM (PE/COFF output for Windows)
rule greeting.o {
    inputs greeting.asm
    command {nasm -f win64 -o $out $in}
}

# Compile the C source
rule hello.o {
    inputs hello.c
    depfile hello.d
    command {$cc $cflags -c -o $out $in -MMD -MF $depfile}
}

# Link both objects into a Windows executable
rule hello.exe {
    inputs hello.o greeting.o
    command {$cc -o $out $in}
}
